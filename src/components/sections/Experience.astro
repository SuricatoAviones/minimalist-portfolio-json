---
import Section from "@/components/Section.astro"
import {work} from "@cv"
import { PRESENT_LABEL, formatMonthYear, getYear } from "@/lib/dates"
---

<Section id="experiencia" title="Experiencia laboral">
    <ul class="jobs">
        {work.map(({name,startDate,endDate,position,summary,highlights,url})=>(
            <li>
                <article>
                    <header>
                        <div>
                            <h3>
                                {url
                                    ? <a href={url} title={`Ver ${name}`} target="_blank" rel="noopener noreferrer">{name}</a>
                                    : name}
                            </h3>
                            <h4>{position}</h4>
                        </div>
                        <p class="dates">
                            <time datetime={startDate} title={formatMonthYear(startDate)}>{getYear(startDate)}</time>
                            {" - "}
                            {endDate
                                ? <time datetime={endDate} title={formatMonthYear(endDate)}>{getYear(endDate)}</time>
                                : PRESENT_LABEL}
                        </p>
                    </header>
                    <p>{summary}</p>
                    {highlights.length > 0 && (
                        <ul class="highlights">
                            {highlights.map((highlight) => <li>{highlight}</li>)}
                        </ul>
                    )}
                </article>
            </li>
        ))}
    </ul>
</Section>

<style>
    .jobs{
        display: flex;
        flex-direction: column;
        gap: 32px;
    }
    article h3{
        font-weight: 500;
    }
    article h3 a:hover{
        text-decoration: underline;
    }
    article h4{
        color: var(--color-subtitle);
        font-weight: 400;
    }
    header{
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 4px;
    }
    .dates{
        flex-shrink: 0;
        font-size: 0.85rem;
        color: var(--color-faint);
    }
    .highlights{
        list-style: disc;
        margin-top: 8px;
        padding-left: 1.25rem;
        color: var(--color-muted);
        font-size: .85rem;
        line-height: 1.5;
    }
</style>
