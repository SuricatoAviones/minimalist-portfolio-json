---
import Section from "@/components/Section.astro"
import type { Basics } from "@/types/cv"
import { ui, type Lang } from "@/i18n/ui"

interface Props {
    lang: Lang
    basics: Basics
}

const { lang, basics } = Astro.props
const { summary } = basics
const t = ui[lang]
---

<Section id="about" title={t.sections.about}>
    <p>{summary}</p>
</Section>
