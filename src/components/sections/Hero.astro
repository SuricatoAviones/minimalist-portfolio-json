---
import {basics} from '@cv'
import Section from '@/components/Section.astro'
import Mail from '@/icons/Mail.astro'
import Phone from '@/icons/Phone.astro'
import GitHub from '@/icons/GitHub.astro'
import X from '@/icons/X.astro'
import LinkedIn from '@/icons/LinkedIn.astro'
import WorldMap from '@/icons/WorldMap.astro'
import Download from '@/icons/Download.astro'
import { avatar, initials } from '@/lib/avatar'
import { CV_PDF_FILENAME, CV_PDF_URL } from '@/lib/cv-download'

const {name,label, location, profiles, phone, email} = basics
const {city,region} = location
const SOCIAL_ICONS :Record<string, any> ={
    GitHub,
    LinkedIn,
    X
}

// Versión en texto plano de los datos de contacto para la versión impresa.
const printInfo = [email, phone, ...profiles.map(({url}) => url)].filter(Boolean).join(' • ')
---

<Section>
    <div class="container">
        <div class="info">
            <h1>{name}</h1>
            <p class="label">{label}</p>
            <p class="location">
                <WorldMap />
                {[city, region].filter(Boolean).join(', ')}
            </p>
            <p class="print">{printInfo}</p>
            <div class="actions no-print">
                <ul class="contact" aria-label="Contacto y redes sociales">
                    {
                        email && (
                            <li>
                                <a href={`mailto:${email}`}
                                    aria-label={`Enviar un correo electrónico a ${email}`}
                                    title={`Enviar un correo electrónico a ${name} al correo ${email}`}>
                                    <Mail />
                                </a>
                            </li>
                        )
                    }
                    {
                        phone && (
                            <li>
                                <a href={`tel:${phone.replace(/[^\d+]/g, '')}`}
                                    aria-label={`Llamar al ${phone}`}
                                    title={`Llamar por teléfono a ${name} al número ${phone}`}>
                                    <Phone />
                                </a>
                            </li>
                        )
                    }
                    {
                        profiles.map(({network,url}) =>{
                            const Icon = SOCIAL_ICONS[network]
                            return(
                                <li>
                                    <a href={url}
                                        aria-label={`Perfil de ${network} (se abre en una pestaña nueva)`}
                                        title={`Visitar el perfil de ${name} en ${network}`}
                                        target="_blank"
                                        rel="noopener noreferrer">
                                        {Icon ? <Icon /> : <span class="network">{network}</span>}
                                    </a>
                                </li>
                            )
                        })
                    }
                </ul>
                <a class="download"
                    href={CV_PDF_URL}
                    download={CV_PDF_FILENAME}
                    type="application/pdf"
                    title="Descargar el CV en PDF optimizado para ATS">
                    <Download />
                    Descargar CV
                </a>
            </div>
        </div>
        <figure>
            {
                avatar
                    ? <img src={avatar} alt={`Foto de ${name}`} width="128" height="128" />
                    : <div class="avatar-fallback" aria-hidden="true">{initials}</div>
            }
        </figure>
    </div>
</Section>

<style>
    .container{
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
    }
    .info{
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
        padding-right: 32px;
    }
    h1{
        font-size: 2rem;
        line-height: 1.2;
    }
    .label{
        color: var(--color-subtitle);
        font-family: var(--font-sans);
        font-weight: 500;
        font-size: 1.1rem;
        line-height: 1.4;
        text-wrap: balance;
    }
    img,
    .avatar-fallback{
        aspect-ratio: 1 / 1;
        width: 128px;
        height: auto;
        border-radius: 16px;
    }
    img{
        object-fit: cover;
    }
    .avatar-fallback{
        display: grid;
        place-items: center;
        background: var(--color-chip);
        color: var(--color-subtitle);
        font-family: var(--font-sans);
        font-size: 2.5rem;
        font-weight: 700;
    }
    .location{
        display: flex;
        align-items: center;
        gap: .25rem;
        font-size: .85rem;
        letter-spacing: -0.05rem;
    }
    .print{
        font-size: .75rem;
    }
    .actions{
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-top: 8px;
    }
    .contact{
        display: flex;
        gap: 4px;
    }
    .contact a,
    .download{
        color: var(--color-faint);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--color-border);
        height: 32px;
        border-radius: 6px;
        transition: background .3s ease, border-color .3s ease, color .3s ease;
    }
    .contact a{
        width: 32px;
        padding: 4px;
    }
    .network{
        font-size: .6rem;
    }
    .download{
        gap: 6px;
        padding: 0 10px;
        color: var(--color-text);
        font-size: .8rem;
        font-weight: 600;
    }
    .contact a:hover,
    .download:hover{
        background: var(--color-chip);
        border-color: var(--color-border-strong);
        color: var(--color-text);
    }
    @media (width <= 700px){
        .container{
            flex-direction: column-reverse;
        }
        .info{
            align-items: center;
            padding-right: 0;
            text-align: center;
        }
        .actions{
            justify-content: center;
        }
        figure{
            margin: 0 auto;
        }
    }
</style>
