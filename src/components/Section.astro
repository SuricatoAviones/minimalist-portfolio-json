---
interface Props {
    id?: string
    title?: string
}

const { id, title } = Astro.props
const headingId = id && title ? `${id}-title` : undefined
---

<section id={id} aria-labelledby={headingId}>
    {title && <h2 id={headingId}>{title}</h2>}
    <slot />
</section>

<style>
    section{
        max-width: 700px;
        margin: 0 auto 48px;
    }
    h2{
        margin-bottom: 8px;
        font-weight: 700;
        line-height: 1.5;
        font-size: 1.5rem;
    }
    @media (width <= 700px){
        section{
            margin-bottom: 38px;
        }
    }
</style>
