---
import { basics, skills } from "@cv"
import { avatar } from "@/lib/avatar"
import { CV_PDF_URL } from "@/lib/cv-download"

interface Props {
	title: string
	description?: string
}

const { title, description = basics.summary } = Astro.props
const { name, label, url, email, location, profiles } = basics

const siteUrl = Astro.site ?? (url ? new URL(url) : undefined)
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined
const imageUrl = avatar && siteUrl ? new URL(avatar, siteUrl).href : undefined

// Datos estructurados (schema.org) para que los buscadores entiendan que la página describe a una persona.
const personSchema = {
	"@context": "https://schema.org",
	"@type": "Person",
	name,
	jobTitle: label,
	description,
	url,
	email: email ? `mailto:${email}` : undefined,
	image: imageUrl,
	address: {
		"@type": "PostalAddress",
		addressLocality: location.city,
		addressRegion: location.region,
		addressCountry: location.countryCode,
	},
	sameAs: profiles.map((profile) => profile.url),
	knowsAbout: skills.map((skill) => skill.name),
}
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="author" content={name} />
		<meta name="generator" content={Astro.generator} />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#0f0f10" media="(prefers-color-scheme: dark)" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="alternate" type="application/pdf" href={CV_PDF_URL} title={`CV de ${name} (PDF)`} />
		{avatar && <link rel="preload" as="image" href={avatar} />}

		<meta property="og:type" content="profile" />
		<meta property="og:locale" content="es_ES" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{imageUrl && <meta property="og:image" content={imageUrl} />}

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{imageUrl && <meta name="twitter:image" content={imageUrl} />}

		<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
	</head>
	<body>
		<slot />
	</body>
</html>

<style is:global>
	:root {
		--color-bg: #ffffff;
		--color-surface: #fdfdfd;
		--color-text: #111111;
		--color-subtitle: #444444;
		--color-muted: #5c5c5c;
		--color-faint: #707070;
		--color-border: #eeeeee;
		--color-border-strong: #dddddd;
		--color-chip: #eeeeee;
		--color-chip-text: #333333;
		--color-accent: #00a32a;
		--color-focus: #2563eb;
		--color-backdrop: rgb(0 0 0 / 0.25);

		--font-mono: Menlo, Monaco, "Lucida Console", "Courier New", Courier, monospace;
		--font-sans: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Oxygen, Ubuntu,
			Cantarell, "Open Sans", "Helvetica Neue", sans-serif;

		color-scheme: light;
	}

	/* Solo en pantalla: al imprimir siempre se usa el tema claro. */
	@media screen and (prefers-color-scheme: dark) {
		:root {
			--color-bg: #0f0f10;
			--color-surface: #161617;
			--color-text: #ededed;
			--color-subtitle: #c9c9c9;
			--color-muted: #a6a6a6;
			--color-faint: #949494;
			--color-border: #262628;
			--color-border-strong: #3a3a3d;
			--color-chip: #232325;
			--color-chip-text: #e5e5e5;
			--color-accent: #3ddc68;
			--color-focus: #7aa2ff;
			--color-backdrop: rgb(0 0 0 / 0.6);

			color-scheme: dark;
		}
	}

	html {
		font-family: var(--font-mono);
		background: var(--color-bg);
		color: var(--color-text);
		letter-spacing: -0.025rem;
		scroll-padding-bottom: 4rem;
	}

	body,
	figure {
		margin: 0;
		padding: 0;
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	h1,
	h2,
	h3,
	h4 {
		margin: 0;
		font-family: var(--font-sans);
		color: var(--color-text);
	}

	p {
		color: var(--color-muted);
		font-size: 0.9rem;
		line-height: 1.5;
		margin: 0;
		text-wrap: pretty;
	}

	kbd {
		background: var(--color-chip);
		color: var(--color-chip-text);
		border-radius: 4px;
		padding: 2px 4px;
		font-family: var(--font-mono);
		font-size: 0.75rem;
	}

	:focus-visible {
		outline: 2px solid var(--color-focus);
		outline-offset: 2px;
		border-radius: 4px;
	}

	.visually-hidden {
		position: absolute;
		width: 1px;
		height: 1px;
		padding: 0;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
		border: 0;
	}

	.print {
		display: none !important;
	}

	@media print {
		.no-print {
			display: none !important;
		}

		.print {
			display: block !important;
		}

		astro-dev-toolbar {
			display: none !important;
		}

		article {
			break-inside: avoid;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		*,
		*::before,
		*::after {
			animation-duration: 0.01ms !important;
			animation-iteration-count: 1 !important;
			transition-duration: 0.01ms !important;
			scroll-behavior: auto !important;
		}
	}
</style>
